# ─────────────────────────────────────────────────────────────────────────────
# Rocky Mountain Booking — environment configuration
#
# Copy to .env.local for local development, and set the same values in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
#
# Anything prefixed NEXT_PUBLIC_ is readable in the browser. Never put a secret
# key behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required before launch ---------------------------------------------------

# Canonical site URL. Used for metadata, sitemap, canonical tags, Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://rockymountainbooking.com

# The demo bot's line, E.164 format. Every click-to-call CTA on the site dials
# this — the display format, (877) 379-9412, is derived automatically.
# Do NOT put a personal mobile here; escalation is configured inside the phone
# system, not published on the website.
NEXT_PUBLIC_DEMO_PHONE=+18773799412

NEXT_PUBLIC_CONTACT_EMAIL=contact@rockymountainbooking.com

# Physical mailing address. REQUIRED for SMS / 10DLC carrier registration —
# it appears on the Privacy Policy and Terms pages.
NEXT_PUBLIC_ADDRESS_LINE1=123 Example St, Suite 100
NEXT_PUBLIC_ADDRESS_LINE2=Colorado Springs, CO 80903


# --- Contact form -------------------------------------------------------------
# Any endpoint that accepts a standard form POST (Formspree, Basin, Netlify).
# If this is left blank the form falls back to opening the visitor's mail client,
# so no lead is ever silently dropped.
NEXT_PUBLIC_FORM_ENDPOINT=


# --- Stripe: option 1, Payment Links (simplest) -------------------------------
# Create a Payment Link per plan in the Stripe dashboard and paste the URLs here.
# No secret keys needed, and /api/checkout is never called.
NEXT_PUBLIC_STRIPE_FOUNDING_LINK=
NEXT_PUBLIC_STRIPE_STANDARD_LINK=


# --- Stripe: option 2, Checkout Sessions --------------------------------------
# Only needed if you leave the Payment Links above blank.
# Create three Prices: one $500 one-time, one $497/mo recurring, one $697/mo.
STRIPE_SECRET_KEY=
STRIPE_SETUP_PRICE_ID=
STRIPE_FOUNDING_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=

# Only needed if you point a Stripe webhook at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
