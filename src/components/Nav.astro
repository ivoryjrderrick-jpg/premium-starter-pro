---
import { site, nav } from '../config/site';

interface Props {
  /** Adds the attention ping to the phone icon. Homepage only. */
  ping?: boolean;
}
const { ping = false } = Astro.props;
const path = Astro.url.pathname;
---

<nav class="nav">
  <a href="/" aria-label={`${site.name} home`} class="brand">
    <svg width="30" height="20" viewBox="0 0 30 20" fill="none" aria-hidden="true">
      <path d="M1 19L9 5l5 8 3-4.5L21 19H1z" fill="var(--gold)"></path>
      <path d="M16 19l6-11 7 11H16z" fill="var(--gold)" opacity=".55"></path>
    </svg>
  </a>

  <div class="nav-right">
    <a
      class:list={['icon-btn', 'phone-btn', { ping }]}
      href={site.phone.href}
      aria-label={`Call ${site.phone.display}`}
    >
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
    </a>

    {/* Three bars drawn as spans so they can morph into an X smoothly. */}
    <button
      class="icon-btn burger"
      id="menu-open"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>
</nav>

<div class="menu" id="menu" aria-hidden="true">
  <div class="menu-top">
    <span class="menu-brand">{site.name}</span>
    <button class="icon-btn burger is-open" id="menu-close" aria-label="Close menu">
      <span class="bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>

  <nav class="menu-body" aria-label="Main">
    <ul class="menu-main">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn menu-cta" href={site.phone.href}>Call {site.phone.display}</a>
  </nav>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: rgba(13, 18, 32, 0.82);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid var(--line-dark);
  }
  .brand {
    display: flex;
    border-radius: 6px;
  }
  .brand:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--white);
    border-radius: 10px;
  }
  .icon-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .phone-btn {
    color: var(--gold);
  }
  .phone-btn.ping {
    animation: ping 2.4s ease-out 1.2s 2;
  }
  @keyframes ping {
    0%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.16);
    }
    24% {
      transform: scale(1);
    }
    36% {
      transform: scale(1.1);
    }
    48% {
      transform: scale(1);
    }
  }

  /* ---- Animated burger -----------------------------------------------------
     Evenly spaced bars on a fixed 20x14 box, so they can never render uneven.
     Opening rotates the outer two into an X and fades the middle out.        */
  .bars {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }
  .bars span {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease;
  }
  .bars span:nth-child(1) {
    top: 0;
  }
  .bars span:nth-child(2) {
    top: 6px;
  }
  .bars span:nth-child(3) {
    top: 12px;
  }
  .burger.is-open .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .burger.is-open .bars span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  .burger.is-open .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---- Full-screen menu ----------------------------------------------------
     Animated with opacity + transform rather than toggling `hidden`, so it
     eases in. `visibility` carries the interactivity: it is delayed on close so
     the fade finishes first, and it keeps the closed overlay out of the tab
     order and off the hit-testing surface.                                    */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--night);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, -10px, 0);
    transition:
      opacity 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.34s;
  }
  .menu.open {
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line-dark);
  }
  .menu-brand {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--white);
  }
  .menu-body {
    padding: 34px 22px 60px;
  }
  .menu-main {
    list-style: none;
    margin-bottom: 34px;
  }
  /* Links cascade in behind the overlay fade. */
  .menu-main li {
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu.open .menu-main li {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .menu.open .menu-main li:nth-child(1) {
    transition-delay: 0.1s;
  }
  .menu.open .menu-main li:nth-child(2) {
    transition-delay: 0.15s;
  }
  .menu.open .menu-main li:nth-child(3) {
    transition-delay: 0.2s;
  }
  .menu.open .menu-main li:nth-child(4) {
    transition-delay: 0.25s;
  }
  .menu.open .menu-main li:nth-child(5) {
    transition-delay: 0.3s;
  }
  .menu-main a {
    display: block;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.9rem, 9vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--white);
    text-decoration: none;
    padding: 6px 0;
  }
  .menu-main a[aria-current='page'] {
    color: var(--gold);
  }
  .menu a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .menu-cta {
    display: block;
    text-align: center;
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.34s,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.34s;
  }
  .menu.open .menu-cta {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu-main li,
    .menu-cta,
    .bars span {
      transition: none;
    }
  }
</style>

<script>
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');
  const menu = document.getElementById('menu');

  if (openBtn && closeBtn && menu) {
    let lastFocused: HTMLElement | null = null;

    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    function open() {
      lastFocused = document.activeElement as HTMLElement;
      menu!.classList.add('open');
      menu!.setAttribute('aria-hidden', 'false');
      openBtn!.setAttribute('aria-expanded', 'true');
      openBtn!.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      focusables()[0]?.focus();
      document.addEventListener('keydown', onKey);
    }

    function close() {
      menu!.classList.remove('open');
      menu!.setAttribute('aria-hidden', 'true');
      openBtn!.setAttribute('aria-expanded', 'false');
      openBtn!.classList.remove('is-open');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      (lastFocused ?? openBtn!).focus();
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;

      // Focus trap: wrap at both ends so Tab can't reach the page behind.
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
  }
</script>
