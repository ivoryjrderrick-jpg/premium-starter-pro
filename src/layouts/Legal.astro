---
import Base from './Base.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  intro: string;
  updated: string;
}
const { title, description, path, heading, intro, updated } = Astro.props;
---

<Base title={title} description={description} path={path}>
  <section class="card dark legal">
    <article class="legal-body">
      <h1>{heading}</h1>
      <p class="legal-meta">Last updated: {updated}</p>
      <p class="legal-intro">{intro}</p>
      <slot />

      <h2>Contact</h2>
      <address class="legal-contact">
        <strong>{site.legalName}</strong><br />
        {site.city}, {site.state}<br />
        <a href={site.phone.href}>{site.phone.display}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </article>
    <div class="stage"></div>
  </section>
</Base>

<style is:global>
  .legal {
    text-align: left;
  }
  .legal-body {
    max-width: 68ch;
    margin: 0 auto;
  }
  .legal-body h1 {
    font-size: clamp(2rem, 7vw, 2.75rem);
    text-align: left;
  }
  .legal-meta {
    font-size: 0.82rem;
    color: var(--muted-dark);
    margin-bottom: 22px;
  }
  .legal-intro {
    font-size: 1.05rem;
    color: var(--white);
    margin-bottom: 8px;
  }
  .legal-body h2 {
    font-size: 1.35rem;
    margin-top: 40px;
    margin-bottom: 10px;
    text-align: left;
  }
  .legal-body h3 {
    font-family: var(--display);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--gold);
    margin-top: 24px;
    margin-bottom: 6px;
  }
  .legal-body p {
    margin-top: 12px;
    color: var(--muted-dark);
    line-height: 1.7;
  }
  .legal-body ul {
    margin-top: 12px;
    padding-left: 20px;
  }
  .legal-body li {
    color: var(--muted-dark);
    line-height: 1.7;
    margin-bottom: 6px;
  }
  .legal-body strong {
    color: var(--white);
  }
  .legal-body a {
    color: var(--gold);
    word-break: break-word;
  }
  .legal-body a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .legal-contact {
    font-style: normal;
    line-height: 1.9;
    color: var(--muted-dark);
    margin-top: 12px;
    padding: 18px;
    border: 1px solid var(--line-dark);
    border-radius: 14px;
  }
</style>
