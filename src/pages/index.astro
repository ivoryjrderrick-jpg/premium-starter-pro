---
import Base from '../layouts/Base.astro';
import { site, trades } from '../config/site';
import DemoAudio from '../components/DemoAudio.astro';

const title = 'Rocky Mountain Booking | Your phone, answered.';
const description =
  'AI phone answering and appointment booking for service businesses. Every call answered day and night, booked straight to your calendar, urgent calls transferred to your cell. Based in Colorado Springs, serving anywhere in the U.S.';

/**
 * Missed-call stack. The numbers are deliberately all zeroes: any realistic
 * pattern gets auto-linked into a live tel: link by iOS Safari, and a made-up
 * number can belong to a real person. See also the format-detection meta.
 */
const missed = [
  { number: '(000) 000-0000', note: 'Missed call', time: '11:42 AM' },
  { number: '(000) 000-0000', note: 'Missed call · no voicemail', time: '1:15 PM' },
  { number: '(000) 000-0000', note: 'Missed call · no voicemail', time: '5:38 PM' },
  { number: '(000) 000-0000', note: 'Missed call · no voicemail', time: '9:47 PM' },
];

const reasons = [
  {
    mark: '01',
    title: 'You were with a customer',
    body: "Stopping mid-job to answer costs you the job you're already on.",
  },
  {
    mark: '02',
    title: 'The other line was ringing',
    body: 'Two calls, one person. One of them goes to voicemail.',
  },
  {
    mark: '03',
    title: 'It was after five',
    body: "Nights, weekends, holidays. Half the week, nobody's there.",
  },
  {
    mark: '04',
    title: 'Your one office person was out',
    body: 'Lunch, sick day, vacation. The whole system was one chair.',
  },
];
---

<Base title={title} description={description} path="/" ping>
  {/* 1 — Hero: the missed-call stack */}
  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">Yesterday</p>
      <h1>Four people tried to hire you.</h1>
      <p class="sub">You were working. They called the next name on the list.</p>
      <div class="links">
        <a class="link" href={site.phone.href}>Test a call <span class="chev">›</span></a>
        <a class="link" href="/contact">Book a call <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage rise">
      <div class="lock stagger">
        {
          missed.map((m) => (
            <div class="miss">
              <div class="m-ico">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M3 3l18 18M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3 4.2 2 2 0 0 1 5 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8" />
                </svg>
              </div>
              <div class="m-txt">
                <div class="m-num">{m.number}</div>
                <div class="m-sub">{m.note}</div>
              </div>
              <div class="m-time">{m.time}</div>
            </div>
          ))
        }
        <p class="tally">Three left no message</p>
      </div>
    </div>
  </section>

  <DemoAudio />

  {/* 2 — Why calls get missed */}
  <section class="card light">
    <div class="rise">
      <p class="eyebrow">It&rsquo;s not the phone</p>
      <h2>Nobody misses calls on purpose.</h2>
      <p class="sub">
        They get missed in the four minutes you couldn&rsquo;t stop what you were doing.
      </p>
    </div>
    <div class="stage rise">
      <div class="reasons stagger">
        {
          reasons.map((r) => (
            <div class="reason">
              <div class="r-mark">{r.mark}</div>
              <div class="r-body">
                <b>{r.title}</b>
                <span>{r.body}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3 — The line answers */}
  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">What changes</p>
      <h2>You pick up. Every time.</h2>
      <p class="sub">
        Your business name, your hours, your services. First ring, every hour of every day.
      </p>
      <div class="links">
        <a class="link" href={site.phone.href}>Test a call <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage rise">
      <div class="phone">
        <div class="notch"></div>
        {/*
          The assistant is not given a name anywhere. Callers hear the client's
          business, so the mock is labelled that way rather than introducing a
          persona the product does not actually use.
        */}
        <div class="callrow">
          <div class="avatar" aria-hidden="true">
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
            </svg>
          </div>
          <div>
            <div class="callname">Your Business</div>
            <div class="callsub">On the line · 0:11</div>
          </div>
        </div>
        <div class="bubble">
          <div class="who">Your business</div>
          Happy to get you on the schedule. Does a morning or an afternoon work better for you?
        </div>
        <div class="bubble gold">
          <div class="who">Caller</div>
          Morning&rsquo;s better. Thursday if you&rsquo;ve got it.
        </div>
      </div>
    </div>
  </section>

  {/* 4 — Booked to the calendar */}
  <section class="card light">
    <div class="rise">
      <p class="eyebrow">Not just answered</p>
      <h2>On your calendar before you&rsquo;re off the ladder.</h2>
      <p class="sub">
        Name, number, address, and what they need. No callback list to work through later.
      </p>
    </div>
    <div class="stage rise">
      <div class="cal">
        <div class="cal-top">Thursday, October 9</div>
        <div class="cal-row">
          <div class="cal-time">8 AM</div>
          <div class="cal-empty"></div>
        </div>
        <div class="cal-row">
          <div class="cal-time">10 AM</div>
          <div class="cal-job">
            <b>New customer, estimate</b>
            <span>D. Alvarez · 2841 Airport Rd</span>
            <span class="cal-flag">Booked 9:47 PM</span>
          </div>
        </div>
        <div class="cal-row">
          <div class="cal-time">1 PM</div>
          <div class="cal-empty"></div>
        </div>
      </div>
    </div>
  </section>

  {/* 5 — Urgent transfer */}
  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">The one everyone asks about</p>
      <h2>Anything urgent still reaches a person.</h2>
      <p class="sub">
        It knows what it can&rsquo;t handle. Those calls go straight to your cell with the details
        texted ahead. If anything ever breaks, calls forward to you automatically. It never
        dead-ends.
      </p>
      <div class="links">
        <a class="link" href="/how-it-works">How the handoff works <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage rise">
      <div class="phone">
        <div class="notch"></div>
        <div class="callrow">
          <div class="avatar" aria-hidden="true">!</div>
          <div>
            <div class="callname">Incoming, transferred</div>
            <div class="callsub">From your line · 11:20 PM</div>
          </div>
        </div>
        <div class="bubble">
          <div class="who">Text sent to you first</div>
          Urgent. Caller says it can&rsquo;t wait until morning. M. Boone, 000-000-0000, 4419 Verde
          Dr. Connecting you now.
        </div>
      </div>
    </div>
  </section>

  {/* 6 — What you get back */}
  <section class="card light">
    <div class="rise">
      <p class="eyebrow">What you get back</p>
      <h2>Your time, and the work you were losing.</h2>
      <p class="sub">
        Every call answered is a customer you already earned. You just weren&rsquo;t free to take it.
      </p>
    </div>
    <div class="stage rise">
      <div class="duo stagger">
        <div class="cell">
          <div class="amt">2 hrs</div>
          <div class="lab">
            A day back, if you&rsquo;re the one answering the phone between jobs.
          </div>
        </div>
        <div class="cell">
          <div class="amt">$149</div>
          <div class="lab">
            What one new lead costs on Google. The ones hitting your voicemail are already paid for.
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 7 — Review Bot. Mechanism only: what it does, never what it will achieve. */}
  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">Also included · Review Bot</p>
      <h2>Every finished job gets asked.</h2>
      <p class="sub">
        A few hours after the appointment, Review Bot texts the customer for a review. Every
        customer, every job.
      </p>
    </div>
    <div class="stage rise">
      <div class="phone">
        <div class="notch"></div>
        <div class="callrow">
          <div class="avatar" aria-hidden="true">R</div>
          <div>
            <div class="callname">Sent 4:12 PM</div>
            <div class="callsub">To D. Alvarez</div>
          </div>
        </div>
        <div class="bubble">
          Hi Dan, thanks for having us out today. Would you mind leaving a quick review? Takes about
          thirty seconds. [link]<br /><br />Reply STOP to opt out.
        </div>
        <div class="stars" role="img" aria-label="Illustration of a five-star review">
          {
            Array.from({ length: 5 }).map(() => (
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3 6.6 7 .9-5 4.9 1.2 7L12 18l-6.2 3.4L7 14.4l-5-4.9 7-.9z" />
              </svg>
            ))
          }
        </div>
      </div>

      {/*
        Industry research only. Every figure is labelled as such, and the
        fineprint below states plainly it is not a promise about the reader's
        business. No projected results, no outcome claims.
      */}
      <p class="eyebrow research-head">What the research says about local search</p>
      <div class="duo stagger">
        <div class="cell">
          <div class="amt">
            <span class="count" data-to="126" data-suffix="%">0%</span>
          </div>
          <div class="lab">
            More traffic goes to the top three on the map than to positions four through ten.
          </div>
          <div class="meter"><i data-fill="100"></i></div>
        </div>
        <div class="cell">
          <div class="amt">5–<span class="count" data-to="9" data-suffix="%">0%</span></div>
          <div class="lab">Revenue lift associated with a one-star increase in average rating.</div>
          <div class="meter"><i data-fill="72"></i></div>
        </div>
      </div>
      <p class="fineprint">
        Recency counts too. Forty reviews from the last six months now outrank two hundred from
        three years ago. Industry figures, not a promise about your business.
      </p>
    </div>
  </section>

  {/* 8 — Trades */}
  <section class="card light">
    <div class="rise">
      <p class="eyebrow">Built for</p>
      <h2>If your phone is how people hire you.</h2>
      <p class="sub">Every trade answers the phone differently. It gets set up for yours.</p>
    </div>
    <div class="stage rise">
      <div class="chips stagger">
        {trades.map((t) => <span class="chip">{t}</span>)}
        <span class="chip more">and more</span>
      </div>
      <div class="links links-after">
        <a class="link" href="/who-we-serve">See who this is built for <span class="chev">›</span></a>
      </div>
    </div>
  </section>

  {/* 9 — Founder */}
  <section class="card dark">
    <div class="rise">
      <img
        class="portrait-img"
        src="/dj-headshot.jpg"
        width="600"
        height="600"
        alt="DJ, who builds and runs Rocky Mountain Booking"
        loading="lazy"
        decoding="async"
      />
      <p class="eyebrow">Who you&rsquo;re actually calling</p>
      <h2>You get me on the phone.</h2>
      <div class="bio">
        <p>
          I&rsquo;m DJ, a military veteran, software engineer, and the founder of Rocky Mountain
          Booking. I&rsquo;ve personally experienced what it&rsquo;s like trying to reach a business,
          only to get sent to voicemail, sit on hold, or hear &ldquo;we&rsquo;re too busy right
          now&rdquo;, and I realized how many great businesses are losing customers simply because
          they can&rsquo;t get to the phone fast enough.
        </p>
        <p>
          I understood the problem because I saw it firsthand, and I knew there had to be a better
          way.
        </p>
        <p class="bio-close">So we built one.</p>
      </div>
      <div class="cta-pair">
        <a class="btn" href="/contact">Book a call with me</a>
        <a class="link" href={site.phone.href}>Or test a call first <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage"></div>
  </section>

  {/* 10 — Closing CTA */}
  <section class="card dark" id="start">
    <div class="rise">
      <h2>Don&rsquo;t take my word for it.</h2>
      <p class="sub">
        Test a call right now and book yourself an appointment. That&rsquo;s what your customer
        hears when you can&rsquo;t pick up.
      </p>
      <div class="cta-pair">
        <a class="btn" href={site.phone.href}>Test a call &middot; {site.phone.display}</a>
        <a class="link" href="/contact">Or book a call with me <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage"></div>
  </section>
</Base>

<style>
  /* The bio runs longer than .sub is sized for, so it gets its own measure. */
  .bio {
    max-width: 46ch;
    margin: 0 auto 22px;
  }
  .bio p {
    font-size: 1.0625rem;
    color: var(--muted-dark);
  }
  .bio p + p {
    margin-top: 14px;
  }
  .bio-close {
    font-family: var(--display);
    font-weight: 600;
    color: var(--white);
  }
  @media (min-width: 700px) {
    .bio p {
      font-size: 1.15rem;
    }
  }

  .research-head {
    margin-top: 38px;
    margin-bottom: 18px;
  }
</style>

<script>
  import '../scripts/motion';
</script>
