---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const title = 'Book a Call | Rocky Mountain Booking';
const description = `Book a call with DJ at ${site.legalName}, ${site.city}, ${site.state}. Leave your name, business and number and he'll call you back the same day.`;

/**
 * The exact consent language shown next to the checkbox. Recorded verbatim with
 * the submission so there is a record of what the person actually agreed to —
 * Twilio rejection code 30513 wants documented opt-in, not just a tick.
 */
const CONSENT_TEXT =
  'I agree to receive text messages from Rocky Mountain Booking about my inquiry. Message and data rates may apply. Reply STOP to opt out, HELP for help.';
---

<Base title={title} description={description} path="/contact">
  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">Book a call</p>
      <h1>Book a call with me.</h1>
      <p class="sub">
        Leave your name, your business and a number. I&rsquo;ll call you back myself, and we&rsquo;ll
        talk through what your phone is actually doing.
      </p>
      <div class="links">
        <a class="link" href={site.phone.href}>
          Call {site.phone.display} <span class="chev">›</span>
        </a>
      </div>
    </div>

    <div class="stage rise">
      {/*
        No method and no action on purpose. There is no endpoint to post to —
        submission is handled in script and handed to the visitor's mail client.
        Declaring method="POST" meant that if the script ever failed to load,
        the browser would post the form, including the phone number, to a static
        host that does nothing with it but may well log the request.
      */}
      <form class="form" id="audit-form" novalidate={false}>
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="business">Business name</label>
          <input
            id="business"
            name="business"
            type="text"
            autocomplete="organization"
            required
          />
        </div>

        <div class="field">
          <label for="phone">Phone</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
          />
        </div>

        {/*
          Two separate boxes on purpose.

          The first gates the submit button. It covers being contacted about the
          request itself, which is what the person is asking for.

          The second is SMS consent. It stays optional and never blocks
          submission, because making messaging consent a condition of service is
          the thing carriers and the TCPA specifically prohibit.
        */}
        <div class="consent">
          <input id="agree" name="agree" type="checkbox" value="yes" required />
          <label for="agree">
            I agree to Rocky Mountain Booking contacting me about this request, and to the{' '}
            <a href="/privacy">Privacy Policy</a>.
          </label>
        </div>

        <div class="consent">
          <input id="sms_consent" name="sms_consent" type="checkbox" value="yes" />
          <label for="sms_consent">
            <span class="optional">Optional.</span> {CONSENT_TEXT}
          </label>
        </div>
        {/*
          The consent wording and the timestamp are deliberately NOT hidden
          inputs any more.

          As form fields they were editable in devtools, which meant the record
          arriving in the inbox was a string the submitter chose. That is the
          wrong shape for something relied on as evidence of opt-in under the
          TCPA and Twilio 30513 — the whole point is that it records what WE
          displayed, not what they typed. Both values now come from the compiled
          script instead, so the record is generated by our code.

          This is a real improvement, not a guarantee: anyone can still edit
          anything inside their own browser. Genuine tamper-resistance needs the
          consent written server-side at the moment of submission, which needs a
          backend this site deliberately does not have. Treat the emailed record
          as good-faith evidence, and keep the phone system's own verbal opt-in
          recording as the authoritative one.
        */}

        {/* Honeypot — hidden from people, visible to bots. */}
        <div class="hp" aria-hidden="true">
          <label for="company_url">Leave this empty</label>
          <input id="company_url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn form-btn" type="submit" id="submit-btn" disabled>Send it over</button>

        <p class="same-day">I&rsquo;ll get back to you the same day.</p>

        {/* The form needs script to submit, so say so rather than failing quietly. */}
        <noscript>
          <p class="no-js-note">
            This form needs JavaScript to send. Call <a href={site.phone.href}>{site.phone.display}</a>
            or email <a href={`mailto:${site.email}`}>{site.email}</a> instead.
          </p>
        </noscript>

        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>

        <p class="form-note">
          By sending this you agree to our <a href="/privacy">Privacy Policy</a>. Ticking the box
          above is optional and is not required to book a call. See our
          <a href="/sms-terms">SMS Terms</a>.
        </p>
      </form>
    </div>
  </section>

  <section class="card light">
    <div class="rise">
      <p class="eyebrow">Or just call</p>
      <h2>You&rsquo;ll get me.</h2>
      <p class="sub">
        {site.legalName} · {site.city}, {site.state}
      </p>
      <div class="links">
        <a class="link" href={site.phone.href}>{site.phone.display} <span class="chev">›</span></a>
        <a class="link" href={`mailto:${site.email}`}>{site.email} <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage"></div>
  </section>
</Base>

<style>
  .form {
    max-width: 400px;
    margin: 0 auto;
    text-align: left;
  }
  .field {
    margin-bottom: 16px;
  }
  .field label {
    display: block;
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 6px;
  }
  .field input,
  .field select {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--line-dark);
    background: var(--night-2);
    color: var(--white);
    font-family: var(--body);
    font-size: 1rem;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .consent input:focus-visible,
  .form-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .field input::placeholder {
    color: var(--muted-dark);
  }

  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--night-2);
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    padding: 14px;
    margin: 20px 0 18px;
  }
  .consent input {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 1px;
    accent-color: var(--gold);
  }
  .consent label {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--muted-dark);
  }
  .consent label a {
    color: var(--gold);
  }
  .optional {
    font-family: var(--display);
    font-weight: 600;
    color: var(--white);
  }

  /* Greyed until the agreement box is ticked. */
  .form-btn:disabled {
    background: var(--night-3);
    color: var(--muted-light);
    cursor: not-allowed;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .form-btn {
    width: 100%;
  }
  .same-day {
    font-size: 0.86rem;
    color: var(--muted-dark);
    margin-top: 12px;
    text-align: center;
  }
  .form-status {
    font-size: 0.88rem;
    color: var(--muted-dark);
    margin-top: 14px;
    min-height: 1.2em;
  }
  .form-note {
    font-size: 0.78rem;
    color: var(--muted-dark);
    margin-top: 14px;
    line-height: 1.5;
  }
  .form-note a {
    color: var(--gold);
  }
  .no-js-note {
    margin-top: 14px;
    padding: 12px 14px;
    border: 1px solid var(--line-dark);
    border-radius: 12px;
    font-size: 0.86rem;
    color: var(--muted-dark);
  }
  .no-js-note a {
    color: var(--gold);
  }
</style>

<script>
  import '../scripts/motion';

  const form = document.getElementById('audit-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const agree = document.getElementById('agree') as HTMLInputElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  // The exact wording rendered next to the SMS checkbox, compiled in rather
  // than read back out of the DOM. See the note in the markup: as a hidden
  // input this was editable by the submitter, which is the wrong property for
  // a consent record. Keep this string identical to CONSENT_TEXT above it.
  const CONSENT_LANGUAGE =
    'I agree to receive text messages from Rocky Mountain Booking about my inquiry. Message and data rates may apply. Reply STOP to opt out, HELP for help.';

  // Button stays greyed out until the agreement box is ticked. The SMS box is
  // deliberately not part of this.
  agree?.addEventListener('change', () => {
    if (submitBtn) submitBtn.disabled = !agree.checked;
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!status) return;

    const data = new FormData(form);

    // Bots fill hidden fields. Show success and drop it.
    if (data.get('company_url')) {
      status.textContent = 'Thanks, I’ll be in touch.';
      form.reset();
      return;
    }

    // Timestamped here, at submit time, from a local — not from a field the
    // submitter could have rewritten.
    const recordedAt = new Date().toISOString();

    const lines = [
      `Name: ${data.get('name') ?? ''}`,
      `Business: ${data.get('business') ?? ''}`,
      `Phone: ${data.get('phone') ?? ''}`,
      '',
      `SMS consent: ${data.get('sms_consent') ? 'YES' : 'no'}`,
      `Consent recorded: ${recordedAt}`,
      `Consent language shown: ${CONSENT_LANGUAGE}`,
    ].join('\n');

    // No mail service is wired up yet, so hand off to the visitor's mail client
    // rather than posting into a void and losing the lead. Swap this for a
    // Formspree/Basin endpoint when one exists.
    const subject = `Book a call: ${data.get('business') || data.get('name') || 'New'}`;
    window.location.href = `mailto:contact@rockymountainbooking.com?subject=${encodeURIComponent(
      subject,
    )}&body=${encodeURIComponent(lines)}`;

    status.textContent = 'Opening your email app…';
  });
</script>
