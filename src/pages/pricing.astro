---
import Base from '../layouts/Base.astro';
import { site, pricing } from '../config/site';

const title = `Pricing | Rocky Mountain Booking`;
const description = `One plan, $${pricing.current} a month at the current rate against a $${pricing.standard} standard rate, plus a $${pricing.setup} one-time setup. No tiers, no per-minute billing, no long-term contract.`;

const included = [
  ['Answering, day and night', 'Every hour of every day, including holidays.'],
  ['Booked straight to your calendar', 'Name, number, address, and what they need.'],
  ['Review Bot', 'Texts every customer for a review a few hours after the job.'],
  ['Urgent calls transferred to you', "With the details texted ahead so you're not starting cold."],
  ['Automatic forwarding if anything breaks', 'Calls roll to your cell. It never dead-ends.'],
  [
    'A number in your area code, set up for you',
    'You do nothing. I build it around how your shop actually runs.',
  ],
  ['A person to call, not a ticket queue', "When something's off, you get me on the phone."],
];

const faqs = [
  [
    "I don't want a robot talking to my customers.",
    "Fair. Don't take my word for it. Call the line and hear it, then ask yourself which one you'd rather your customer got. That, or your voicemail.",
  ],
  [
    'My wife handles the phone.',
    "Good, and she should keep doing it. This covers the hours she isn't working. Nights, weekends, and the times she's already on the other line.",
  ],
  [
    'What if it botches something urgent?',
    'Urgent calls don’t get booked. They transfer straight to your cell, and the details get texted to you first. If the system ever fails, calls forward to your phone automatically.',
  ],
  [
    'Does Review Bot only ask happy customers?',
    "No. Every customer gets the same message. Filtering out the unhappy ones violates Google's policies and is the fastest way to get a profile flagged.",
  ],
  [
    'Is there a contract?',
    'Month to month. Thirty days’ notice either direction. The rate you start at is the rate you keep, and that part is in writing.',
  ],
  [
    "How long until it's running?",
    'About a week from the day you say go. You spend maybe thirty minutes on it total.',
  ],
  [
    'Why is it cheaper than the other guys?',
    "Because I'm one person with almost no overhead, and because you're early. The rate goes up once I've got case studies.",
  ],
];
---

<Base title={title} description={description} path="/pricing">
  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">Pricing</p>
      <h1>One plan. One price.</h1>
      <p class="sub">No tiers, no per-minute billing, no long-term contract.</p>
    </div>
    <div class="stage rise">
      <div class="pricebox" id="pricebox" data-from={pricing.standard} data-to={pricing.current}>
        {/*
          The struck figure is the CURRENT standard rate with an offer against
          it — not a historical price. It is labelled as such, and that label is
          the reason this does not read as "was $399".

          "Limited time only" only stays truthful if the rate genuinely rises.
          An offer that never ends, against a list price nobody is ever charged,
          is what the FTC treats as deceptive pricing. Set a real date to move
          it, or change this badge back to "Current rate".
        */}
        <div class="oldwrap">
          <div class="oldprice">
            <span class="oldlabel">Standard rate</span>
            <span class="oldnum">${pricing.standard}/mo</span>
          </div>
        </div>
        <p class="now">
          {/*
            Renders the CURRENT rate so the box still reads correctly with no
            JS. The count-up resets it to the standard rate before it runs.
          */}
          <span class="dollar">$</span><span id="priceNum">{pricing.current}</span><span class="per"
            >/mo</span
          >
        </p>
        <p class="badge">Limited time only</p>
        <p class="lock-note">Whatever rate you start at is the rate you keep, in writing.</p>
        <p class="setup">
          <b>${pricing.setup} one-time setup.</b> Covers building it around your business.
        </p>
      </div>
    </div>
  </section>

  <section class="card light">
    <div class="rise">
      <p class="eyebrow">What&rsquo;s included</p>
      <h2>All of it. There&rsquo;s no upgrade.</h2>
    </div>
    <div class="stage rise">
      <div class="incl stagger">
        {
          included.map(([label, detail]) => (
            <div class="inc">
              <span class="tick" aria-hidden="true">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>
              <span>
                <b>{label}</b>
                <span>{detail}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="card light">
    <div class="rise">
      <p class="eyebrow">The only math that matters</p>
      <h2>One job covers the month.</h2>
      <p class="sub">Use your own numbers. If the answer isn&rsquo;t obvious, don&rsquo;t buy it.</p>
    </div>
    <div class="stage rise">
      {/*
        The first three values are inputs. They are drawn as filled, bordered
        fields rather than bare numbers, because as plain text nobody realised
        they were editable — and the hint line plus the one-off pulse on reveal
        says it outright rather than relying on the styling alone.
      */}
      <div class="mathbox">
        <p class="edit-hint">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
          </svg>
          Tap a number to put your own in
        </p>

        <div class="mrow">
          <label for="m-missed">Calls you miss in a week</label>
          <span class="v"
            ><span class="mi-box"
              ><input
                id="m-missed"
                class="mi"
                type="number"
                inputmode="numeric"
                min="0"
                max="200"
                step="1"
                value="4"
              /></span
            ></span
          >
        </div>
        <div class="mrow">
          <label for="m-rate">Of those, how many would&rsquo;ve booked</label>
          <span class="v"
            ><span class="mi-box"
              ><input
                id="m-rate"
                class="mi"
                type="number"
                inputmode="numeric"
                min="0"
                max="100"
                step="1"
                value="25"
              /><span class="unit">%</span></span
            ></span
          >
        </div>
        <div class="mrow">
          <label for="m-job">Your average job</label>
          <span class="v"
            ><span class="mi-box"
              ><span class="unit pre">$</span><input
                id="m-job"
                class="mi wide"
                type="number"
                inputmode="numeric"
                min="0"
                max="100000"
                step="10"
                value="400"
              /></span
            ></span
          >
        </div>
        <div class="mrow">
          {/* Matches the default inputs: 4 × 4.33 × 25% × $400. Recalculated on load. */}
          <span>Recovered in a month</span><span class="v" id="m-out">$1,732</span>
        </div>
        <div class="mrow win">
          <span>Cost</span><span class="v" data-cost={pricing.current}>${pricing.current}</span>
        </div>
      </div>
      <p class="sub math-note">Those are placeholder numbers. On a call I&rsquo;ll run yours.</p>
    </div>
  </section>

  <section class="card dark">
    <div class="rise">
      <p class="eyebrow">How to start</p>
      <h2>Try it for thirty days.</h2>
    </div>
    <div class="stage rise">
      {/*
        No refund or money-back language anywhere — the offer is a genuine
        month-to-month trial, not a guarantee. Keep this wording in step with
        the Terms of Service.
      */}
      <div class="guar">
        <h3>Run it a month and see what it catches.</h3>
        <p>
          Month to month from day one. Cancel inside the first thirty days and nothing further is
          due. After that it&rsquo;s thirty days&rsquo; notice, any time, no reason needed and no
          early termination fee. Setup is one-time and stays non-refundable. You keep every job it
          books.
        </p>
      </div>
    </div>
  </section>

  <section class="card light">
    <div class="rise">
      <p class="eyebrow">Straight answers</p>
      <h2>What people ask.</h2>
    </div>
    <div class="stage rise">
      <div class="faq">
        {
          faqs.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="card dark">
    <div class="rise">
      <h2>Hear it before you decide.</h2>
      <p class="sub">Test a call and book yourself an appointment. Takes two minutes.</p>
      <div class="cta-pair">
        <a class="btn" href={site.phone.href}>Test a call &middot; {site.phone.display}</a>
        <a class="link" href="/contact">Or book a call with me <span class="chev">›</span></a>
      </div>
    </div>
    <div class="stage"></div>
  </section>
</Base>

<style>
  .pricebox {
    max-width: 400px;
    margin: 0 auto;
    background: var(--night-2);
    border: 1px solid var(--line-dark);
    border-radius: 22px;
    padding: 30px 24px;
    text-align: center;
  }

  /* Reserved height so the rising standard rate never shifts layout, and the
     mask the standard rate slides up out of.

     This block and the badge below are the only two animations on the site that
     run automatically inside the viewport on load, which makes them the only
     two an automated audit can catch mid-transition. Fading text from opacity 0
     means every intermediate frame is a genuine contrast failure — a11y tools
     read the blended colour, and at 40% through the fade the label really is
     unreadable. So neither element fades: the standard rate is masked and slides
     into view at full colour, and the badge springs in with a visibility step.
     Same motion to the eye, no partial-opacity text at any instant. */
  .oldwrap {
    min-height: 48px;
    margin-bottom: 4px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    overflow: hidden;
  }
  .oldprice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  /* Both starting states are scoped to .js, the same as the scroll reveals — if
     the script never runs, the box renders complete rather than missing its
     standard rate and its badge. */
  :global(.js) .oldprice {
    transform: translate3d(0, 115%, 0);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.95s;
  }
  .oldlabel {
    font-family: var(--display);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }
  .oldnum {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--muted-dark);
    position: relative;
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }
  /* Strikethrough draws left to right once the number has landed. Drawn by
     default and wound back only under .js, so the no-script box still shows a
     struck standard rate rather than two live prices. */
  .oldnum::after {
    content: '';
    position: absolute;
    left: -4px;
    right: -4px;
    top: 52%;
    height: 2px;
    background: rgba(255, 107, 107, 0.85);
    border-radius: 2px;
    transform: scaleX(1);
    transform-origin: left center;
  }
  :global(.js) .oldnum::after {
    transform: scaleX(0);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1) 1.45s;
  }
  .pricebox.go .oldprice {
    transform: translate3d(0, 0, 0);
  }
  .pricebox.go .oldnum::after {
    transform: scaleX(1);
  }

  .now {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(3.4rem, 17vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    color: var(--gold);
    margin: 0;
  }
  :global(.js) .now {
    color: var(--muted-dark);
    transition: color 0.7s ease;
  }
  .pricebox.go .now {
    color: var(--gold);
  }
  .now .dollar {
    font-size: 0.5em;
    vertical-align: 0.42em;
    margin-right: 0.04em;
  }
  .now .per {
    font-size: 0.26em;
    color: var(--muted-dark);
    letter-spacing: 0;
    margin-left: 0.15em;
    vertical-align: 0.5em;
  }

  .badge {
    display: inline-block;
    font-family: var(--display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--gold);
    padding: 6px 13px;
    border-radius: 999px;
    margin-top: 16px;
  }
  /* visibility is discrete: 0s duration with the same delay flips it at the
     START of the spring rather than the end, so it appears and scales as one
     movement. */
  :global(.js) .badge {
    visibility: hidden;
    transform: scale(0.9);
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 1.7s,
      visibility 0s linear 1.7s;
  }
  .pricebox.go .badge {
    visibility: visible;
    transform: scale(1);
  }

  .lock-note {
    font-size: 0.86rem;
    color: var(--muted-dark);
    max-width: 31ch;
    margin: 12px auto 0;
  }
  .setup {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--line-dark);
    font-size: 0.9rem;
    color: var(--muted-dark);
  }
  .setup b {
    color: var(--white);
    font-family: var(--display);
  }

  .incl {
    max-width: 400px;
    margin: 0 auto;
    text-align: left;
  }
  .inc {
    display: flex;
    gap: 13px;
    padding: 13px 0;
    border-top: 1px solid var(--line-light);
  }
  .inc:last-child {
    border-bottom: 1px solid var(--line-light);
  }
  .tick {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(201, 144, 42, 0.16);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--gold-deep);
  }
  .inc b {
    font-family: var(--display);
    font-size: 0.98rem;
    display: block;
    margin-bottom: 1px;
  }
  .inc > span:last-child > span {
    font-size: 0.86rem;
    color: var(--muted-light);
  }

  .mathbox {
    max-width: 400px;
    margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--line-light);
    border-radius: 18px;
    padding: 24px 20px;
    text-align: left;
  }
  .mrow {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 0;
    font-size: 0.94rem;
    border-bottom: 1px solid var(--line-light);
  }
  .mrow:last-child {
    border-bottom: 0;
    padding-top: 15px;
    margin-top: 4px;
    border-top: 2px solid var(--ink);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .mrow .v {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }
  .mrow label {
    cursor: pointer;
  }

  /* The affordance line. Sits above the rows so it is read before the first
     field rather than explaining something the eye has already passed. */
  .edit-hint {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--gold-deep);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-light);
  }
  .edit-hint svg {
    flex-shrink: 0;
  }

  /* Each editable value is drawn as a real field: filled, bordered, tappable.
     The box carries the border so the unit sign ($ / %) sits inside it and the
     whole thing reads as one control. */
  .mi-box {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    background: var(--snow);
    border: 1px solid rgba(13, 18, 32, 0.22);
    border-radius: 9px;
    padding: 3px 9px;
    cursor: text;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }
  .mi-box:hover {
    border-color: var(--gold-deep);
  }
  .mi-box:focus-within {
    border-color: var(--gold-deep);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(201, 144, 42, 0.22);
  }
  .unit {
    color: var(--muted-light);
  }

  /* The field itself is transparent — .mi-box supplies every visible edge, so
     there is only one border to keep in sync. */
  .mi {
    width: 3ch;
    text-align: right;
    font: inherit;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
  }
  .mi.wide {
    width: 5.5ch;
  }
  .mi:focus,
  .mi:focus-visible {
    outline: 0;
  }
  /* Strip the spinners so the row keeps its typographic rhythm. */
  .mi::-webkit-outer-spin-button,
  .mi::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .mi {
    -moz-appearance: textfield;
    appearance: textfield;
  }
  /* One-off attention pulse when the block scrolls in, staggered down the three
     fields so it reads as "these three move" rather than a flash. Two cycles
     only — it is a hint, not an animation that keeps demanding attention. */
  @keyframes editPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(201, 144, 42, 0);
      border-color: rgba(13, 18, 32, 0.22);
    }
    40% {
      box-shadow: 0 0 0 5px rgba(201, 144, 42, 0.2);
      border-color: var(--gold-deep);
    }
  }
  .rise.in .mi-box {
    animation: editPulse 1.15s cubic-bezier(0.4, 0, 0.2, 1) 2 both;
  }
  .rise.in .mrow:nth-of-type(1) .mi-box {
    animation-delay: 0.45s;
  }
  .rise.in .mrow:nth-of-type(2) .mi-box {
    animation-delay: 0.6s;
  }
  .rise.in .mrow:nth-of-type(3) .mi-box {
    animation-delay: 0.75s;
  }
  /* Once someone touches any of them, stop hinting. Specificity has to beat
     `.rise.in .mi-box` above or the animation keeps overriding the focus ring. */
  .rise.in .mathbox.touched .mi-box,
  .rise.in .mi-box:focus-within {
    animation: none;
  }

  .mrow.win .v {
    color: var(--gold-deep);
  }
  .math-note {
    margin-top: 22px;
    margin-bottom: 0;
    font-size: 0.86rem;
  }

  .guar {
    max-width: 400px;
    margin: 0 auto;
    border: 2px solid var(--gold);
    border-radius: 18px;
    padding: 26px 22px;
    background: rgba(245, 184, 74, 0.06);
  }
  .guar h3 {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 9px;
  }
  .guar p {
    font-size: 0.95rem;
    color: var(--muted-dark);
  }

  .faq {
    max-width: 440px;
    margin: 0 auto;
    text-align: left;
  }
  .faq details {
    border-top: 1px solid var(--line-light);
    padding: 16px 0;
  }
  .faq details:last-of-type {
    border-bottom: 1px solid var(--line-light);
  }
  .faq summary {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-size: 1.4rem;
    line-height: 1;
    color: var(--gold-deep);
    flex-shrink: 0;
  }
  .faq details[open] summary::after {
    content: '\2013';
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .faq details p {
    font-size: 0.92rem;
    color: var(--muted-light);
    margin-top: 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .oldprice,
    .oldnum::after,
    .badge,
    .now {
      transition: none;
    }
    .rise.in .mi-box {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/motion';

  const missed = document.getElementById('m-missed') as HTMLInputElement | null;
  const rate = document.getElementById('m-rate') as HTMLInputElement | null;
  const job = document.getElementById('m-job') as HTMLInputElement | null;
  const out = document.getElementById('m-out');

  if (missed && rate && job && out) {
    const money = (n: number) =>
      '$' + Math.round(n).toLocaleString('en-US', { maximumFractionDigits: 0 });

    // Clamp to the input's own min/max so a pasted value can't produce nonsense.
    const val = (el: HTMLInputElement) => {
      const n = Number(el.value);
      if (!isFinite(n)) return Number(el.min || 0);
      return Math.min(Number(el.max), Math.max(Number(el.min), n));
    };

    const recalc = () => {
      // 4.33 weeks a month, so the figure matches a real month rather than four weeks.
      out.textContent = money(val(missed) * 4.33 * (val(rate) / 100) * val(job));
    };

    const box = missed.closest('.mathbox');

    [missed, rate, job].forEach((el) => {
      el.addEventListener('input', recalc);
      // First interaction retires the hint pulse for good.
      el.addEventListener('focus', () => box?.classList.add('touched'), { once: true });
      // Write the clamped value back on blur, so the figure on screen always
      // matches the one the total was calculated from.
      el.addEventListener('change', () => {
        el.value = String(val(el));
        recalc();
      });
    });
    recalc();
  }
</script>
